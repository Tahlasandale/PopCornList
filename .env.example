# Configuration PopCornList
# Copier ce fichier vers .env et remplacer les valeurs :
#   cp .env.example .env
#
# Variables disponibles :
#   TMDB_API_KEY   — Clé API TMDB
#                    Défaut intégré dans le code (build direct fonctionne).
#                    Surcharger via --dart-define=TMDB_API_KEY=xxx pour CI/CD.
#   MISTRAL_API_KEY — Clé API Mistral (optionnelle, recommendations IA)
#                    Pas de défaut intégré — utiliser --dart-define si besoin.

TMDB_API_KEY=ta_cle_api_tmdb_ici
MISTRAL_API_KEY=ta_cle_api_mistral_ici
